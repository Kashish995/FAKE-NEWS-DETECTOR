NEWSAPI_KEY=

# Optional: Google Fact Check Tools API Key (Google Cloud Console)
FACTCHECK_API_KEY=

# Optional: OCR.space API Key (https://ocr.space/ocrapi)
OCR_API_KEY=helloworld
